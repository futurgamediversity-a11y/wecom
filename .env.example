# Firebase Configuration
#
# These values are inlined into the browser bundle at build time (see `env`
# in next.config.ts), so change them here and rebuild — they are not read at
# runtime. FIREBASE_STORAGE_BUCKET is only needed if you start using
# Firebase Storage.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
